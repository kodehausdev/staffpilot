# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # server-side only — never expose to browser

# Tenant (only needed for local dev without auth)
NEXT_PUBLIC_DEMO_TENANT_ID=your-tenant-uuid-here

# Backend URL
NEXT_PUBLIC_BACKEND_URL=https://localhost:8000

# App URL (used in billing callbacks)
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Admin key (must match backend SECRET_KEY)
BACKEND_ADMIN_KEY=change-this-in-production

# Paystack — server-side only, never expose to browser
PAYSTACK_SECRET_KEY=sk_test_xxxx


